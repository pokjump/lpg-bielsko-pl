<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com; media-src 'self'; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  <FilesMatch "\.(woff2|webp|png|jpg|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.lpg\.bielsko\.pl$ [NC]
RewriteRule ^(.*)$ https://lpg.bielsko.pl/$1 [R=301,L]

RewriteRule ^kontakt\.html$       https://lpg.bielsko.pl/#kontakt [R=301,L,NE]

RewriteRule ^uslugi/?$            https://lpg.bielsko.pl/#uslugi [R=301,L,NE]

RewriteRule ^oferta\.html$        https://lpg.bielsko.pl/instalacje-lpg [R=301,L]
RewriteRule ^zenit\.html$         https://lpg.bielsko.pl/instalacje-lpg [R=301,L]
RewriteRule ^pro\.html$           https://lpg.bielsko.pl/instalacje-lpg [R=301,L]
RewriteRule ^compact\.html$       https://lpg.bielsko.pl/instalacje-lpg [R=301,L]
RewriteRule ^wtryskiwacze\.html$  https://lpg.bielsko.pl/instalacje-lpg [R=301,L]
RewriteRule ^lovato\.html$        https://lpg.bielsko.pl/instalacje-lpg [R=301,L]
RewriteRule ^tartarini\.html$     https://lpg.bielsko.pl/instalacje-lpg [R=301,L]

RewriteRule ^haki\.html$          https://lpg.bielsko.pl/haki-holownicze [R=301,L]

RewriteRule ^diagnostyka\.html$   https://lpg.bielsko.pl/diagnostyka-komputerowa [R=301,L]
RewriteRule ^carchip\.html$       https://lpg.bielsko.pl/diagnostyka-komputerowa [R=301,L]
RewriteRule ^tuning\.html$        https://lpg.bielsko.pl/diagnostyka-komputerowa [R=301,L]

RewriteRule ^airbag\.html$        https://lpg.bielsko.pl/elektronika-alarmy [R=301,L]
RewriteRule ^radio\.html$         https://lpg.bielsko.pl/elektronika-alarmy [R=301,L]
RewriteRule ^alarmy\.html$        https://lpg.bielsko.pl/elektronika-alarmy [R=301,L]
RewriteRule ^immobilisery\.html$  https://lpg.bielsko.pl/elektronika-alarmy [R=301,L]
RewriteRule ^cofanie\.html$       https://lpg.bielsko.pl/elektronika-alarmy [R=301,L]
RewriteRule ^blokady\.html$       https://lpg.bielsko.pl/elektronika-alarmy [R=301,L]
RewriteRule ^bolcowe\.html$       https://lpg.bielsko.pl/elektronika-alarmy [R=301,L]
RewriteRule ^ryglowe\.html$       https://lpg.bielsko.pl/elektronika-alarmy [R=301,L]

RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond $1 !^404$
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^./]+)$ $1.html [L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
RewriteCond %1 !^404$
RewriteRule ^ /%1 [R=301,L]

ErrorDocument 404 /404.html

DirectoryIndex index.html
Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml application/xhtml+xml application/rss+xml image/x-icon font/woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
